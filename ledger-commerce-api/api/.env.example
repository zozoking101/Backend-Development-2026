# 🚀 App config
PORT=3000

# api/.env.development
# to connect to mongodb locally
# MONGO_PROTOCOL=mongodb
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB_NAME=my-app-db
# MONGO_USERNAME=user
# MONGO_PASSWORD=****

# 🔐 Auth / security (API-specific)
# JWT_SECRET=supersecretjwt
# JWT_EXPIRES_IN=1d

# 🔑 Feature flags / internal behavior
# ENABLE_REQUEST_LOGGING=true
# ENABLE_CACHE=false

# 📦 Business logic config
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ⏱️ Timeouts / limits
# REQUEST_TIMEOUT_MS=5000

# 🧪 Debugging
# LOG_LEVEL=debug