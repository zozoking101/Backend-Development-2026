# 🌍 Global environment
NODE_ENV=development
COMPOSE_PROJECT_NAME=ledger-commerce

# 🚪 Ports exposed to your machine
API_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379

#MONGODB CONFIG
# 🗄️ MongoDB (shared across services)
# MONGO_URI=mongodb://mongo:27017/my-app-db
MONGO_PROTOCOL=mongodb
MONGO_HOST=mongo
MONGO_DB_NAME=my-app-db
MONGO_USERNAME=user
MONGO_PASSWORD=PASSWORD_HERE

# 🔗 Full connection string (optional but convenient)
# MONGO_URI=mongodb://admin:supersecret@mongo:27017/ledger_commerce

# ⚡ Redis (if you add caching, queues later)
# REDIS_HOST=redis
# REDIS_PASSWORD=redispass

# 📨 Message broker (future: queues, events)
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# 🌐 Shared service URLs (for inter-service communication)
# API_BASE_URL=http://api:3000
# AUTH_SERVICE_URL=http://auth:4000